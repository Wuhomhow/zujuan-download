<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>试卷下载工具</title>
  <style>
    body{font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;padding:12px;width:340px;color:#1f2937;background:#fff}
    .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
    .topbar strong{font-size:15px}
    .topbar a{color:#007AFF;text-decoration:none;font-size:12px;display:inline-flex;align-items:center;gap:3px}
    .topbar a:hover{text-decoration:underline}
    .card{border:1px solid #e5e7eb;border-radius:8px;padding:12px;margin-bottom:10px}
    .row{display:flex;justify-content:space-between;gap:8px;margin:6px 0;align-items:center}
    .error{color:#b91c1c;font-size:12px}
    .muted{color:#6b7280;font-size:12px}
    button{border:1px solid #d1d5db;background:#fff;border-radius:6px;padding:8px 10px;cursor:pointer;font:inherit}
    button:disabled{opacity:.5;cursor:not-allowed}
    .detect-row{display:flex;align-items:center;gap:6px;margin:-2px 0 10px;position:relative}
    .help-q{flex:none;width:15px;height:15px;border-radius:50%;border:1px solid #d1d5db;color:#9ca3af;font-size:10px;line-height:1;display:inline-flex;align-items:center;justify-content:center;cursor:help;user-select:none}
    /* 纯 CSS 气泡提示：扩展 popup 里原生 title 提示不显示，改用 hover 气泡。
       锚定 detect-row（而非问号本身），避免检测文案变长时气泡被顶出右边界 */
    .help-q .help-tip{display:none;position:absolute;top:calc(100% + 2px);left:0;width:252px;padding:8px 10px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.12);color:#4b5563;font-size:12px;line-height:1.6;text-align:left;cursor:default;user-select:text;z-index:50}
    .help-q:hover .help-tip{display:block}
    /* 系统信息降噪：弱化卡片视觉层级 */
    .sys-info{background:#fafafa;border-color:#f3f4f6;padding:10px 12px;color:#6b7280}
    .sys-info .row{margin:4px 0;font-size:12px}
    .sys-info .row>strong{font-size:12px;font-weight:500;color:#6b7280}
    .version-info{display:inline-flex;align-items:center;gap:4px;margin-left:5px;color:#9ca3af;font-size:11px;font-weight:400}
    /* —— Apple-style buttons —— */
    .btn-primary{display:block;width:100%;background:#007AFF;color:#fff;border:none;border-radius:12px;padding:12px 16px;font-size:15px;font-weight:600;cursor:pointer;letter-spacing:.2px;box-shadow:0 2px 8px rgba(0,122,255,.25);transition:all .15s ease}
    .btn-primary:hover{background:#0066d6;box-shadow:0 4px 12px rgba(0,122,255,.35)}
    .btn-primary:active{transform:scale(.98)}
    .btn-primary:disabled{background:#a0c4ff;box-shadow:none;cursor:not-allowed;transform:none}
    .btn-row{display:flex;flex-direction:column;gap:10px;margin-top:8px}
    .page-detect{display:flex;align-items:center;gap:5px;font-size:12px;color:#9ca3af}
    .page-detect::before{content:"";flex:none;width:7px;height:7px;border-radius:50%;background:#d1d5db}
    .page-detect.ok{color:#15803d}
    .page-detect.ok::before{background:#22c55e}
    .page-detect.no{color:#9ca3af}
    .btn-hint{font-size:12px;color:#6b7280;text-align:center;line-height:1.5;margin-top:6px;padding:0 4px}
    .license-card{background:#f8fbff;border-color:#dbeafe}
    .license-title{font-weight:650;color:#111827;margin-bottom:7px}
    .license-form{display:flex;gap:7px}
    .license-form input{min-width:0;flex:1;border:1px solid #d1d5db;border-radius:7px;padding:8px;font:inherit;text-transform:uppercase}
    .license-form input:focus{outline:2px solid #bfdbfe;border-color:#60a5fa}
    .license-status{font-size:12px;color:#6b7280;margin-top:7px;line-height:1.5}
    .license-status.active{color:#15803d}
    .license-actions{display:flex;justify-content:flex-end;margin-top:5px}
    .link-btn{border:0;background:none;color:#6b7280;padding:2px;font-size:12px}
    .device-code{display:flex;gap:6px;align-items:center;margin:7px 0;font-size:11px;color:#64748b}
    .device-code code{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;background:#fff;border:1px solid #e5e7eb;border-radius:5px;padding:4px 6px}
    .device-code button{padding:4px 7px;font-size:11px}
  </style>
</head>
<body>
  <div class="topbar">
    <strong>试卷下载工具</strong>
  </div>

  <!-- 支持网站说明折叠为问号入口，hover 查看 -->
  <div class="detect-row">
    <div id="pageDetect" class="page-detect">检测当前页…</div>
    <span class="help-q">?<span class="help-tip">组卷网全站支持，菁优网除专辑外全站支持。</span></span>
  </div>

  <div class="card license-card">
    <div class="license-title">卡密授权</div>
    <div class="device-code"><span>设备码</span><code id="deviceCode">读取中…</code><button id="copyDevice">复制</button></div>
    <div id="licenseForm" class="license-form">
      <input id="licenseKey" autocomplete="off" spellcheck="false" placeholder="请输入卡密">
      <button id="activateLicense">激活</button>
    </div>
    <div id="licenseStatus" class="license-status">正在检查授权…</div>
    <div id="licenseActions" class="license-actions" hidden>
      <button id="deactivateLicense" class="link-btn">解绑本设备</button>
    </div>
  </div>

  <div class="card sys-info">
    <div class="row"><strong>系统信息<span class="version-info"><span id="currentVersion"></span></span></strong></div>
  </div>

  <!-- 导出按钮卡片 -->
  <div class="card">
    <div class="btn-row">
      <button id="downloadCurrent" class="btn-primary">下载试卷</button>
    </div>
    <div class="btn-hint" id="btnHint">试卷一键导出为 Word / PDF，纯前端本地处理</div>
    <div id="error" class="error" style="margin-top:8px;"></div>
  </div>

  <script type="module" src="popup.js"></script>

</body>
</html>
